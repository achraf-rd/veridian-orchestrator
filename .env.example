# NVIDIA NIM — OpenAI-compatible endpoint (GPT-OSS orchestrator brain).
# If left blank, these fall back to the sibling Veridian_frontend/.env.
NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NIM_API_KEY=
NIM_MODEL=openai/gpt-oss-120b

# MCP gateway (veridian-mcp-gateway, Streamable HTTP)
MCP_GATEWAY_URL=http://127.0.0.1:8100/mcp

# Postgres for durable LangGraph checkpoints (same DB as the Next.js app).
# Falls back to in-memory if unset/unreachable. Also read from the frontend .env.
DATABASE_URL=

ORCH_HOST=127.0.0.1
ORCH_PORT=8200
